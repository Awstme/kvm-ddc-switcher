# KVM USB Hub 在 ioreg 里的产品名
KVM_HUB_NAME="USB 2.0 Hub [Safe]"
MONITOR_NAME="Mi Monitor"

# 轮询间隔（秒）；连续 STABLE_SAMPLES 次读到同一状态才动作
POLL_INTERVAL=0.5
STABLE_SAMPLES=2

# 1 = 只记录，不发 DDC；0 = 真正切到 Windows 输入
DRY_RUN=0

# 只做 Mac -> Windows 自动切出；切回 Mac 手动 OSD
# 显示器输入源（DDC VCP 0x60）
# DP1=15, DP2=16, HDMI1=17, HDMI2=18, USB-C=27
MAC_INPUT=15
WINDOWS_INPUT=16

# 必须显式指定 Mi Monitor，避免内置屏成为主屏时 m1ddc 打错显示器
DISPLAY_SELECTOR="20B810E8-52BC-4BB8-BCFB-62179D76B820"

# 工具和日志（相对脚本目录，便于仓库迁移）
M1DDC="$DIR/m1ddc-src/m1ddc"
LOG="$DIR/logs/kvm-auto-switch.log"
